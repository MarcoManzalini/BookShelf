<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8+): the launcher crops it to its own shape
     (circle, squircle...) instead of showing a square on a white disc.
     In dark mode the foreground and color come from the -night folders, on
     launchers that redraw icons when the system theme changes. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
